{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/lib/numbers.ts",
    "src/lib/progress-storage.ts",
    "tests/**/*.test.ts"
  ]
}
